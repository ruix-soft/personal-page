---
// src/components/ProjectItem.astro
import Card from './Card.astro';
import ItemList from './ItemList.astro'; // Assuming ItemList can be used for technologies

export interface Props {
  titleKey?: string;
  titleDefault?: string;
  problemKey: string;
  problemDefault: string;
  roleKey: string;
  roleDefault: string;
  technologiesKey: string; // Key for the "Technologies" subtitle
  technologiesDefault: string; // Default for "Technologies" subtitle
  technologies: Array<{ key: string; default: string }>; // Array of technologies
  resultKey: string;
  resultDefault: string;
  visualUrl?: string; // URL for an image or external project link
  visualAltKey?: string; // Alt text for image, translation key
  visualAltDefault?: string; // Default alt text for image
}

const {
  titleKey,
  titleDefault,
  problemKey,
  problemDefault,
  roleKey,
  roleDefault,
  technologiesKey,
  technologiesDefault,
  technologies,
  resultKey,
  resultDefault,
  visualUrl,
  visualAltKey,
  visualAltDefault
} = Astro.props;
---

<div class="mb-8 p-0.5 rounded-lg bg-gradient-to-tr from-blue-500 via-purple-500 to-pink-500 shadow-lg">
  <Card>
    <div class="flex flex-col md:flex-row gap-6">
      {visualUrl && (visualUrl.startsWith('http://') || visualUrl.startsWith('https://')) && !visualUrl.endsWith('.jpg') && !visualUrl.endsWith('.png') && !visualUrl.endsWith('.jpeg') && !visualUrl.endsWith('.gif') && (
        <div class="md:w-1/3 flex-shrink-0 mb-4 md:mb-0">
          <a href={visualUrl} target="_blank" rel="noopener noreferrer" class="block hover:opacity-80 transition-opacity">
            <img
              src="/images/project-link-placeholder.png"  // Placeholder image for external link
              alt={visualAltDefault ? visualAltDefault : 'Project link'}
              data-translate-alt-key={visualAltKey}
              class="w-full h-auto rounded-md shadow-md object-cover"
            />
            <p class="text-center text-sm mt-2 text-gray-400" data-translate-key="project.viewLink" data-translate-default="View Project">View Project</p>
          </a>
        </div>
      )}
      {visualUrl && (visualUrl.endsWith('.jpg') || visualUrl.endsWith('.png') || visualUrl.endsWith('.jpeg') || visualUrl.endsWith('.gif') || visualUrl.startsWith('/images/')) && (
        <div class="md:w-1/3 flex-shrink-0 mb-4 md:mb-0">
          <img
            src={visualUrl}
            alt={visualAltDefault ? visualAltDefault : 'Project visual'}
            data-translate-alt-key={visualAltKey}
            class="w-full h-auto rounded-md shadow-md object-cover"
          />
        </div>
      )}
      <div class="flex-grow">
        {titleKey && (
          <h2 class="text-2xl font-bold mb-4 text-white" data-translate-key={titleKey} data-translate-default={titleDefault}>{titleDefault}</h2>
        )}
        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key="project.problem" data-translate-default="El Problema">El Problema</h3>
        <p class="text-gray-300 mb-4" data-translate-key={problemKey} data-translate-default={problemDefault}>{problemDefault}</p>

        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key="project.role" data-translate-default="Tu Rol">Tu Rol</h3>
        <p class="text-gray-300 mb-4" data-translate-key={roleKey} data-translate-default={roleDefault}>{roleDefault}</p>

        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key={technologiesKey} data-translate-default={technologiesDefault}>Las Tecnologías</h3>
        {technologies && technologies.length > 0 && (
          <div class="mb-4">
            <ItemList items={technologies.map(tech => ({ key: tech.key, default: tech.default }))} class="list-disc list-inside text-gray-300" />
          </div>
        )}

        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key="project.result" data-translate-default="El Resultado">El Resultado</h3>
        <p class="text-gray-300" data-translate-key={resultKey} data-translate-default={resultDefault}>{resultDefault}</p>
      </div>
    </div>
  </Card>
</div>
