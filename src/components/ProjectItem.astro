---
// src/components/ProjectItem.astro
import Card from './Card.astro';
import ItemList from './ItemList.astro'; // Assuming ItemList can be used for technologies

export interface Props {
  titleKey?: string;
  titleDefault?: string;
  problemKey: string;
  problemDefault: string;
  roleKey: string;
  roleDefault: string;
  technologiesKey: string; // Key for the "Technologies" subtitle
  technologiesDefault: string; // Default for "Technologies" subtitle
  technologies: Array<{ key: string; default: string }>; // Array of technologies
  resultKey: string;
  resultDefault: string;
}

const {
  titleKey,
  titleDefault,
  problemKey,
  problemDefault,
  roleKey,
  roleDefault,
  technologiesKey,
  technologiesDefault,
  technologies,
  resultKey,
  resultDefault
} = Astro.props;
---

<div class="mb-8 p-0.5 rounded-lg bg-gradient-to-tr from-blue-500 via-purple-500 to-pink-500 shadow-lg">
  <Card>
    <div class="flex flex-col md:flex-row gap-6">
      <div class="flex-grow">
        {titleKey && (
          <h2 class="text-2xl font-bold mb-4 text-white" data-translate-key={titleKey} data-translate-default={titleDefault}>{titleDefault}</h2>
        )}
        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key="project.problem" data-translate-default="El Problema">El Problema</h3>
        <p class="text-gray-300 mb-4" data-translate-key={problemKey} data-translate-default={problemDefault}>{problemDefault}</p>

        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key="project.role" data-translate-default="Mi Rol">Mi Rol</h3>
        <p class="text-gray-300 mb-4" data-translate-key={roleKey} data-translate-default={roleDefault}>{roleDefault}</p>

        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key={technologiesKey} data-translate-default={technologiesDefault}>Las Tecnologías</h3>
        {technologies && technologies.length > 0 && (
          <div class="mb-4">
            <ItemList items={technologies.map(tech => ({ key: tech.key, default: tech.default }))} class="list-disc list-inside text-gray-300" />
          </div>
        )}

        <h3 class="text-xl font-semibold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-translate-key="project.result" data-translate-default="El Resultado">El Resultado</h3>
        <p class="text-gray-300" data-translate-key={resultKey} data-translate-default={resultDefault}>{resultDefault}</p>
      </div>
    </div>
  </Card>
</div>
