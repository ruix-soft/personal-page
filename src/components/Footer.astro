---
// No props needed for this component as it's a static footer
---

<footer class="pt-8 mt-12 border-t border-gray-800 text-center">
  <div class="mb-8">
    <h4 class="text-xs font-mono text-purple-400 uppercase tracking-wider mb-4" data-translate-key="footer.network_title">
      Ecosistema & Red
    </h4>
    <div class="flex flex-wrap justify-center gap-4 sm:gap-8 text-sm">
      <a
        href="https://ruix.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="link-hover flex items-center text-gray-400 hover:text-purple-300 transition-colors"
      >
        <span data-translate-key="footer.link_main">Perfil Principal & CV</span>
        <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <a
        href="https://services.ruix.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="link-hover flex items-center text-gray-400 hover:text-purple-300 transition-colors"
      >
        <span data-translate-key="footer.link_services">Servicios & Consultoría</span>
        <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <a
        href="https://articles.ruix.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="link-hover flex items-center text-gray-400 hover:text-purple-300 transition-colors"
      >
        <span data-translate-key="footer.link_articles">Artículos & Blog</span>
        <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  <p class="text-gray-500 text-sm">
    &copy; <span id="currentYear"></span> Luis Alberto Ruiz Arias. <span data-translate-key="footer.rights">Todos los derechos reservados.</span>
  </p>
  <p class="text-xs text-gray-600 mt-1" data-translate-key="footer.design">
    Diseñado con Tailwind CSS y creado con Astro.
  </p>
</footer>

<script>
  // Set current year
  const currentYearElement = document.getElementById("currentYear");
  if (currentYearElement) {
    currentYearElement.textContent = String(new Date().getFullYear());
  }
</script>
