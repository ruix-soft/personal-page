---
// No props needed for this component as it's a static background
---

<div id="parallax-background-svg-container">
  <svg
    width="100%"
    height="100%"
    viewBox="0 0 1000 700"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="pGrad1" x1="0%" y1="0%" x2="100%" y2="100%"
        ><stop offset="0%" style="stop-color:#C4B5FD; stop-opacity:0.9"
        ></stop><stop
          offset="100%"
          style="stop-color:#A78BFA; stop-opacity:0.7"
        ></stop></linearGradient
      >
      <linearGradient id="pGrad2" x1="0%" y1="100%" x2="100%" y2="0%"
        ><stop offset="0%" style="stop-color:#8B5CF6; stop-opacity:0.8"
        ></stop><stop
          offset="100%"
          style="stop-color:#7C3AED; stop-opacity:0.6"
        ></stop></linearGradient
      >
      <linearGradient id="pGrad3" x1="0%" y1="0%" x2="100%" y2="100%"
        ><stop offset="0%" style="stop-color:#6D28D9; stop-opacity:0.7"
        ></stop><stop
          offset="100%"
          style="stop-color:#5B21B6; stop-opacity:0.5"
        ></stop></linearGradient
      >
      <radialGradient
        id="pSphereGrad"
        cx="40%"
        cy="40%"
        r="60%"
        fx="30%"
        fy="30%"
        ><stop offset="0%" style="stop-color:#EDE9FE; stop-opacity:0.9"
        ></stop><stop
          offset="60%"
          style="stop-color:#A78BFA; stop-opacity:0.8"></stop><stop
          offset="100%"
          style="stop-color:#6D28D9; stop-opacity:0.6"
        ></stop></radialGradient
      >
    </defs>
    <g id="parallax-fig1-wrapper" data-parallax-factor="0.15"
      ><g transform="translate(80 120) rotate(15) scale(1.2)"
        ><polygon points="0,30 50,0 100,30 50,60" fill="#A78BFA"
        ></polygon><polygon points="0,30 0,90 50,120 50,60" fill="#7C3AED"
        ></polygon><polygon
          points="50,60 50,120 100,90 100,30"
          fill="#5B21B6"></polygon></g
      ></g
    >
    <g id="parallax-fig2-wrapper" data-parallax-factor="-0.1"
      ><circle cx="450" cy="150" r="80" fill="url(#pSphereGrad)"
      ></circle></g
    >
    <g id="parallax-fig3-wrapper" data-parallax-factor="0.2"
      ><g transform="translate(200 400) rotate(-25) scale(1.4)"
        ><rect x="0" y="0" width="120" height="50" fill="#8B5CF6"
        ></rect><polygon points="0,0 20,-20 140,-20 120,0" fill="#A78BFA"
        ></polygon><polygon
          points="120,0 140,-20 140,30 120,50"
          fill="#6D28D9"></polygon></g
      ></g
    >
    <g id="parallax-fig4-wrapper" data-parallax-factor="-0.12"
      ><g transform="translate(750 480) rotate(30) scale(1.1)"
        ><polygon points="50,0 0,80 100,80" fill="#C4B5FD"
        ></polygon><polygon points="50,0 100,80 80,90" fill="#A78BFA"
        ></polygon><polygon points="50,0 0,80 20,90" fill="#8B5CF6"
        ></polygon></g
      ></g
    >
    <g id="parallax-fig5-wrapper" data-parallax-factor="0.08"
      ><g transform="translate(120 550) rotate(-10) scale(1.3)"
        ><ellipse cx="50" cy="20" rx="50" ry="15" fill="#7C3AED"
        ></ellipse><rect x="0" y="20" width="100" height="60" fill="#6D28D9"
        ></rect><ellipse cx="50" cy="80" rx="50" ry="15" fill="#5B21B6"
        ></ellipse></g
      ></g
    >
    <g id="parallax-fig6-wrapper" data-parallax-factor="0.25"
      ><rect
        x="600"
        y="80"
        width="180"
        height="180"
        fill="url(#pGrad1)"
        transform="rotate(55 690 170)"></rect></g
    >
    <g id="parallax-fig7-wrapper" data-parallax-factor="-0.05"
      ><circle cx="880" cy="250" r="120" fill="url(#pGrad3)"></circle></g
    >
    <g id="parallax-fig8-wrapper" data-parallax-factor="0.1"
      ><polygon
        points="500,300 580,250 600,350 520,400"
        fill="url(#pGrad2)"
        transform="rotate(-15 550 325)"></polygon></g
    >
    <g id="parallax-fig9-wrapper" data-parallax-factor="-0.18"
      ><g transform="translate(350 50) rotate(40) scale(0.9)"
        ><ellipse cx="0" cy="0" rx="100" ry="40" fill="#6D28D9"
        ></ellipse></g
      ></g
    >
  </svg>
</div>
