---
import LanguageToggle from "./LanguageToggle.astro";

interface NavItem {
  href: string;
  translateKey: string;
  defaultText: string;
}

interface Props {
  name?: string;
  navItems?: NavItem[];
}

const defaultNavItems: NavItem[] = [
  { href: "#summary", translateKey: "nav.summary", defaultText: "<RESUMEN/>" },
  { href: "#experience", translateKey: "nav.experience", defaultText: "<EXPERIENCIA/>" },
  { href: "#skills", translateKey: "nav.skills", defaultText: "<HABILIDADES/>" },
  { href: "#education", translateKey: "nav.education", defaultText: "<EDUCACIÓN/>" },
  { href: "#languages-softskills", translateKey: "nav.languages_etc", defaultText: "<IDIOMAS_ETC/>" },
];

const { name = "Luis A. Ruiz Arias", navItems = defaultNavItems } = Astro.props;
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-gray-900 bg-opacity-80 backdrop-blur-md shadow-lg"
>
  <div class="container mx-auto max-w-5xl px-4">
    <div class="flex justify-between items-center py-3">
      <div class="md:hidden">
        <button
          id="hamburger-button"
          aria-label="Abrir menú de navegación"
          class="text-gray-300 hover:text-purple-400 focus:outline-none focus:text-purple-400"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

      <div class="hidden md:block text-sm text-purple-400">
        {name}
      </div>

      <ul
        class="hidden md:flex flex-wrap justify-center items-center space-x-1 sm:space-x-2"
      >
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link" data-translate-key={item.translateKey}
              >{item.defaultText}</a
            >
          </li>
        ))}
      </ul>
      <LanguageToggle />
    </div>
  </div>
</nav>
