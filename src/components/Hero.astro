---
interface Props {
  name: string;
  email: string;
  linkedinUrl: string;
  location: string;
}

const { 
  name = "Luis Alberto Ruiz Arias",
  email = "luisalbertoruiz.geek@gmail.com",
  linkedinUrl = "https://www.linkedin.com/in/luis-alberto-ruiz-arias/",
  location = "Cuautitlán Izcalli, MEX"
} = Astro.props;
---

<section
  id="hero"
  class="hero-section container mx-auto max-w-4xl px-4 py-16 sm:py-24 text-left"
  aria-labelledby="hero-main-text"
>
  <div class="relative z-10">
    <p class="hero-small-text" data-translate-key="hero.greeting">
      Hola, mi nombre es
    </p>
    <h1 id="hero-main-text" class="hero-main-text">
      {name}.
    </h1>
    <h2 class="hero-tagline" data-translate-key="hero.tagline">
      Construyo soluciones tecnológicas.
    </h2>
    <p class="hero-description" data-translate-key="hero.description">
      Soy un Director de TI y líder técnico global especializado en dirigir equipos y entregar proyectos innovadores a nivel internacional. Actualmente, como Team Developer Leader en Fortidia, estoy enfocado en impulsar la transformación digital y optimizar soluciones tecnológicas altamente escalables.
    </p>
    <div
      class="mt-8 flex flex-col sm:flex-row items-start sm:items-center space-y-3 sm:space-y-0 sm:space-x-6"
    >
      <a
        href={`mailto:${email}`}
        class="link-hover flex items-center text-gray-300 hover:text-purple-400 transition-colors duration-300 text-sm"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5 mr-2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
          ></path></svg
        >
        {email}
      </a>
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="link-hover flex items-center text-gray-300 hover:text-purple-400 transition-colors duration-300 text-sm"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
          class="w-5 h-5 mr-2"
          ><path
            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
          ></path></svg
        >
        <span data-translate-key="contact.linkedin">LinkedIn</span>
      </a>
      <span class="flex items-center text-gray-300 text-sm">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5 mr-2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
          ></path></svg
        >
        <span data-translate-key="contact.location">{location}</span>
      </span>
    </div>
  </div>
</section>
