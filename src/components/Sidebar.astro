---
interface NavItem {
  href: string;
  translateKey: string;
  defaultText: string;
}

interface Props {
  navItems?: NavItem[];
}

const defaultNavItems: NavItem[] = [
  { href: "#summary", translateKey: "nav.summary", defaultText: "<RESUMEN/>" },
  { href: "#experience", translateKey: "nav.experience", defaultText: "<EXPERIENCIA/>" },
  { href: "#skills", translateKey: "nav.skills", defaultText: "<HABILIDADES/>" },
  { href: "#education", translateKey: "nav.education", defaultText: "<EDUCACIÓN/>" },
  { href: "#languages-softskills", translateKey: "nav.languages_etc", defaultText: "<IDIOMAS_ETC/>" },
];

const { navItems = defaultNavItems } = Astro.props;
---

<div
  id="sidebar"
  class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-lg p-6 z-40 md:hidden"
  role="navigation"
  aria-label="Main navigation menu"
>
  <button
    id="close-sidebar-button"
    aria-label="Close navigation menu"
    data-translate-key="nav.close"
    class="absolute top-16 right-4 text-gray-300 hover:text-purple-400"
  >
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  <ul class="mt-16 flex flex-col space-y-3">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class="nav-link block text-lg"
          data-translate-key={item.translateKey}>{item.defaultText}</a
        >
      </li>
    ))}
  </ul>
</div>
