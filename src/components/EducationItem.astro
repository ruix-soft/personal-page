---
interface Props {
  degreeKey: string;
  degreeDefault: string;
  institutionKey: string;
  institutionDefault: string;
  dateKey: string;
  dateDefault: string;
}

const { 
  degreeKey, 
  degreeDefault, 
  institutionKey, 
  institutionDefault, 
  dateKey, 
  dateDefault 
} = Astro.props;
---

<div class="card p-6 rounded-lg shadow-lg">
  <h3
    class="text-xl font-semibold text-white"
    data-translate-key={degreeKey}
  >
    {degreeDefault}
  </h3>
  <p class="text-purple-300 mb-1">
    <span data-translate-key={institutionKey}>{institutionDefault}</span> | <span data-translate-key={dateKey}>{dateDefault}</span>
  </p>
</div>
