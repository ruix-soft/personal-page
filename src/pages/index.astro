---
import "../styles/global.css";
import ExperienceItem from "../components/ExperienceItem.astro";
import EducationItem from "../components/EducationItem.astro";
import SkillsCategory from "../components/SkillsCategory.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ParallaxBackground from "../components/ParallaxBackground.astro";
import Navigation from "../components/Navigation.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import ItemList from "../components/ItemList.astro";
import ProjectItem from "../components/ProjectItem.astro";
import TranslationScript from "../components/TranslationScript.astro";
import Head from "../components/Head.astro";
---

<html lang="es">
  <Head />
  <body class="antialiased">
    <ParallaxBackground />
    <div id="sidebar-overlay" class="md:hidden"></div>
    <Navigation />
    <Sidebar />
    <main>
      <Hero
        name="Luis Alberto Ruiz Arias"
        email="luisalbertoruiz.geek@gmail.com"
        linkedinUrl="https://www.linkedin.com/in/luis-alberto-ruiz-arias/"
        location="Cuautitlán Izcalli, MEX"
      />
      <div class="container mx-auto max-w-5xl px-4 pb-8 sm:pb-12 relative z-10">
        <Section id="summary" paddingTop={true} aria-labelledby="summary-title">
          <SectionTitle
            id="summary-title"
            translateKey="title.summary"
            defaultText="Resumen Profesional"
          />
          <p
            class="text-lg text-gray-300 leading-relaxed"
            data-translate-key="summary.paragraph"
          >
            Profesional de TI experimentado con más de 10 años liderando equipos
            multidisciplinarios y entregando proyectos tecnológicos en LATAM.
            Experto en implementar y optimizar soluciones de software escalables
            con arquitecturas modernas y mejores prácticas de ingeniería (DDD,
            TDD, CI/CD). Capacidad comprobada para gestionar iniciativas a gran
            escala, impulsar la transformación digital y alinear la tecnología
            con los objetivos comerciales. Fuerte enfoque en la mejora continua
            y el liderazgo ético.
          </p>
        </Section>
        <Section id="experience" aria-labelledby="experience-title">
          <SectionTitle
            id="experience-title"
            translateKey="title.experience"
            defaultText="Experiencia Profesional"
            marginBottom="mb-8"
          />
          <div class="relative">
            <div class="timeline-line hidden sm:block"></div>
                        <ExperienceItem
              titleKey="exp0.title"
              titleDefault="Principal Software Architect"
              company="Fortidia | Milan, Lombardy, Italy (Remote)"
              dateKey="exp0.date"
              dateDefault="Jan 2026 - Present"
              descriptions={[
                { key: "exp0.desc1", default: "Architect scalable global enterprise solutions utilizing Domain-Driven Design (DDD), Hexagonal, and Clean Architecture principles." },
                { key: "exp0.desc2", default: "Manage, optimize, and scale core backend systems and production databases for LATAM and global operations." },
                { key: "exp0.desc3", default: "Accelerate the software development lifecycle and enhance code quality by integrating AI-assisted engineering tools, including LLMs, GitHub Copilot, and Ollama." },
              ]}
            />
            <ExperienceItem
              titleKey="exp1.title"
              titleDefault="Lead Full Stack Engineer"
              company="Independent Software Architect"
              dateKey="exp1.date"
              dateDefault="2025 - 2026"
              descriptions={[
                { key: "exp1.desc1", default: "Architected and engineered \"Falcon,\" a comprehensive cross-border PO Box tracking system, managing the end-to-end software development lifecycle." },
                { key: "exp1.desc2", default: "Developed highly concurrent backend services utilizing Go, optimizing data throughput and ensuring real-time tracking accuracy." },
                { key: "exp1.desc3", default: "Built the front-end ecosystem (React SPA) and mobile application (React Native), and designed robust relational database schemas and API contracts." },
              ]}
            />
            <ExperienceItem
              titleKey="exp2.title"
              titleDefault="Principal Software Architect / Head of Engineering"
              company="MBE México | Mexico City, Mexico (Hybrid)"
              dateKey="exp2.date"
              dateDefault="Oct 2021 - Apr 2026"
              descriptions={[
                { key: "exp2.desc1", default: "Engineered and executed the end-to-end migration of legacy on-premise infrastructure to a highly available, cloud-native AWS environment." },
                { key: "exp2.desc2", default: "Architected and deployed \"Rocket,\" a flagship proprietary system that automated complex core logistical processes." },
                { key: "exp2.desc3", default: "Refactored APIs, significantly reducing technical debt, and implemented Clean and Hexagonal Architecture to ensure long-term maintainability and scalability." },
              ]}
            />
            <ExperienceItem
              titleKey="exp3.title"
              titleDefault="Senior Software Engineer"
              company="Price Travel Holding | Mexico City, Mexico"
              dateKey="exp3.date"
              dateDefault="Aug 2019 - Oct 2020"
              descriptions={[
                { key: "exp3.desc1", default: "Developed high-performance Single Page Applications (SPAs) based on an advanced microfrontend architecture." },
                { key: "exp3.desc2", default: "Optimized web components using strict atomic design methodologies and visual unit testing." },
                { key: "exp3.desc3", default: "Built and maintained internal code libraries, utilizing the native Fetch API for highly optimized web service integrations." },
              ]}
            />
            <ExperienceItem
              titleKey="exp4.title"
              titleDefault="Lead Software Engineer"
              company="Sellcom Solutions | Huixquilucan, Mexico"
              dateKey="exp4.date"
              dateDefault="Nov 2018 - Aug 2019"
              descriptions={[
                { key: "exp4.desc1", default: "Defined the core software architecture and strategically selected technology stacks for multiple enterprise client projects." },
                { key: "exp4.desc2", default: "Engineered and implemented CI/CD pipelines and standardized repository management." },
                { key: "exp4.desc3", default: "Translated complex business requirements into precise technical specifications and database models." },
              ]}
            />
            <ExperienceItem
              titleKey="exp5.title"
              titleDefault="Senior Full Stack Developer"
              company="Grupo Sports World | Mexico City, Mexico"
              dateKey="exp5.date"
              dateDefault="Nov 2016 - Nov 2018"
              descriptions={[
                { key: "exp5.desc1", default: "Executed complex database migrations to AWS and configured highly scalable cloud infrastructure." },
                { key: "exp5.desc2", default: "Maintained and evolved RESTful backend APIs for iOS and Android platforms utilizing Python and Laravel." },
                { key: "exp5.desc3", default: "Developed hardware integration interfaces for biometric scanners, QR code readers, and RFID-based security systems." },
              ]}
            />
            <ExperienceItem
              titleKey="exp6.title"
              titleDefault="Full Stack Developer"
              company="Avantika | Huixquilucan, Mexico"
              dateKey="exp6.date"
              dateDefault="Jul 2015 - Jun 2016"
              descriptions={[
                { key: "exp6.desc1", default: "Engineered custom software solutions, focusing on scalable database architecture and robust backend implementations." },
                { key: "exp6.desc2", default: "Developed and integrated complex electronic invoicing (e-invoicing) modules, ensuring strict regulatory compliance." },
              ]}
            />
            <ExperienceItem
              titleKey="exp7.title"
              titleDefault="Software Developer"
              company="Secretariat of Science, Technology, and Innovation (CDMX) | Mexico City, Mexico"
              dateKey="exp7.date"
              dateDefault="Jun 2014 - Jun 2015"
              descriptions={[
                { key: "exp7.desc1", default: "Developed high-traffic web applications utilizing Laravel and Symfony frameworks." },
              ]}
            />
          </div>
        </Section>
        <Section id="skills" aria-labelledby="skills-title">
          <SectionTitle
            id="skills-title"
            translateKey="title.skills"
            defaultText="Habilidades Técnicas"
          />
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <SkillsCategory
              categoryKey="skills.cat_languages"
              categoryDefault="Lenguajes"
              skills={["JavaScript", "TypeScript", "Java", "PHP", "C#", "Go"]}
            />
            <SkillsCategory
              categoryKey="skills.cat_frameworks"
              categoryDefault="Frameworks"
              skills={[
                "React",
                "React Native",
                "Astro",
                "Next.js",
                "Laravel",
                "Spring",
                ".NET",
                "SAM",
              ]}
            />
            <SkillsCategory
              categoryKey="skills.cat_databases"
              categoryDefault="Bases de Datos"
              skills={[
                "MySQL",
                "PostgreSQL",
                "SQL Server",
                "MongoDB",
                "Redis",
                "Firebase",
              ]}
            />
            <SkillsCategory
              categoryKey="skills.cat_webdev"
              categoryDefault="Desarrollo Web"
              skills={["HTML5", "CSS3", "Sass", "Tailwind", "Redux", "Node.js"]}
            />
            <SkillsCategory
              categoryKey="skills.cat_devops"
              categoryDefault="DevOps"
              skills={[
                "Git",
                "GitLab",
                "Docker",
                "Kubernetes",
                "CI/CD",
                "AWS",
                "Azure",
                "GCP",
                "EventBridge",
                "CloudFormation",
                "Serverless",
              ]}
            />
            <SkillsCategory
              categoryKey="skills.cat_tools"
              categoryDefault="Herramientas"
              skills={[
                "Vite",
                "Webpack",
                "SWC",
                "esbuild",
                "Yarn",
                "npm",
                "JWT",
                "StoryBook",
                "n8n",
                "Notion",
              ]}
            />
            <SkillsCategory
              categoryKey="skills.cat_testing"
              categoryDefault="Pruebas"
              skills={["Jest", "Playwright", "react-testing-library"]}
            />
            <SkillsCategory
              categoryKey="skills.cat_architectures"
              categoryDefault="Arquitecturas"
              skills={[
                "Hexagonal",
                "SOLID",
                "MVC",
                "REST",
                "Microfrontends",
                "Microservicios",
                "Arquitectura Orientada a Eventos",
              ]}
            />
          </div>
        </Section>
        <Section id="education" aria-labelledby="education-title">
          <SectionTitle
            id="education-title"
            translateKey="title.education"
            defaultText="Educación y Certificaciones"
          />
          <div class="space-y-6">
            <EducationItem
              degreeKey="edu.master.degree"
              degreeDefault="Master's in Information Science (Incomplete)"
              institutionKey="edu.master.institution"
              institutionDefault="Instituto Leonardo Bravo"
              dateKey="edu.master.date"
              dateDefault="2018 - 2019"
            />
            <EducationItem
              degreeKey="edu1.degree"
              degreeDefault="B.S. in Information Science (Incompleto)"
              institutionKey="edu1.institution"
              institutionDefault="Instituto Leonardo Bravo"
              dateKey="edu1.date"
              dateDefault="2011 - 2015"
            />
            <EducationItem
              degreeKey="edu2.degree"
              degreeDefault="Certificaciones en HTML5, CSS3, PostgreSQL"
              institutionKey="edu2.institution"
              institutionDefault="Open Intelligence"
              dateKey="edu2.date"
              dateDefault="2014"
            />
            <EducationItem
              degreeKey="edu3.degree"
              degreeDefault="Certificación en Arquitectura Hexagonal"
              institutionKey="edu3.institution"
              institutionDefault="Codely"
              dateKey="edu3.date"
              dateDefault="2023 - 2024"
            />
          </div>
        </Section>
        <Section
          id="languages-softskills"
          aria-labelledby="languages-softskills-title"
          paddingTop={true}
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <SectionTitle
                id="languages-title"
                translateKey="title.languages"
                defaultText="Idiomas"
              />
              <Card>
                <ItemList
                  items={[
                    { key: "lang.spanish", default: "Español: Nativo" },
                    { key: "lang.english", default: "Inglés: Intermedio" },
                  ]}
                />
              </Card>
            </div>
            <div>
              <SectionTitle
                id="softskills-title"
                translateKey="title.softskills"
                defaultText="Habilidades Blandas"
              />
              <Card>
                <ItemList
                  items={[
                    {
                      key: "softskill1",
                      default: "Liderazgo y Gestión de Equipos",
                    },
                    { key: "softskill2", default: "Pensamiento Estratégico" },
                    { key: "softskill3", default: "Comunicación Efectiva" },
                    { key: "softskill4", default: "Resolución de Problemas" },
                    { key: "softskill5", default: "Adaptabilidad" },
                    { key: "softskill6", default: "Proactividad" },
                  ]}
                />
              </Card>
            </div>
          </div>
        </Section>
        <Section id="featured-projects" aria-labelledby="featured-projects-title" paddingTop={true}>
          <SectionTitle
            id="featured-projects-title"
            translateKey="title.featuredProjects"
            defaultText="Proyectos Destacados"
            marginBottom="mb-8"
          />
          <ProjectItem
            titleKey="project1.title"
            titleDefault="Falcon – Sistema Agnóstico de Logística Cross-Border"
            problemKey="project1.problem"
            problemDefault="Falta de trazabilidad, automatización y escalabilidad en la gestión de casilleros internacionales (PO Box), recepción de paquetería en frontera y despacho de envíos transfronterizos con múltiples transportistas."
            roleKey="project1.role"
            roleDefault="Diseñé la arquitectura e implementé la solución backend/database desde cero como consultor e ingeniero principal, definiendo los flujos de datos, integración de transportistas y contratos API."
            technologiesKey="project.technologies"
            technologiesDefault="Las Tecnologías"
            technologies={[
              { key: 'tech.node_ts', default: 'Node.js / TypeScript' },
              { key: 'tech.postgresql_multi', default: 'PostgreSQL (Modelado de datos multitenant)' },
              { key: 'tech.aws_serverless', default: 'AWS (Servicios Serverless / Cloud Functions)' },
              { key: 'tech.api_carriers', default: 'Integración con APIs de transportistas (Shipping Carriers REST/SOAP)' },
            ]}
            resultKey="project1.result"
            resultDefault="Se construyó un core logístico agnóstico capaz de procesar inventario en almacén, generación automatizada de guías, cálculo de tarifas de importación y rastreo en tiempo real, reduciendo la fricción operativa y errores manuales de registro."
          />

          <ProjectItem
            titleKey="project2.title"
            titleDefault="Rocket – Middleware Core & Reingeniería de Plataforma Logística"
            problemKey="project2.problem"
            problemDefault="Sistemas legados acoplados con alto costo de mantenimiento, baja escalabilidad y cuellos de botella en el procesamiento e integración de órdenes operativas masivas a nivel regional."
            roleKey="project2.role"
            roleDefault="Lideré la dirección de arquitectura y modernización del software core. Diseñé e implementé la transición hacia una arquitectura desacoplada y orientada a eventos para orquestar la operación logística end-to-end."
            technologiesKey="project.technologies"
            technologiesDefault="Las Tecnologías"
            technologies={[
              { key: 'tech.node_go_ts', default: 'Node.js / Go / TypeScript' },
              { key: 'tech.event_driven', default: 'Arquitectura Orientada a Eventos (Microservicios / Message Queue)' },
              { key: 'tech.aws_infrastructure', default: 'Amazon Web Services (AWS Infrastructure & Cloud-Native)' },
              { key: 'tech.databases_rel_nosql', default: 'Bases de Datos Relacionales y NoSQL' },
            ]}
            resultKey="project2.result"
            resultDefault="Se logró la modernización completa de la infraestructura crítica de la plataforma, optimizando los tiempos de respuesta del API, mejorando la disponibilidad del sistema frente a picos de tráfico y facilitando la integración transparente con múltiples integradores y clientes."
          />
        </Section>
        <Footer />
      </div>
    </main>
    <TranslationScript />
  </body>
</html>
