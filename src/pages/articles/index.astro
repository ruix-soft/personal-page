---
import { getCollection } from 'astro:content';
import Head from '../../components/Head.astro';
import Navigation from '../../components/Navigation.astro';
import Sidebar from '../../components/Sidebar.astro';
import ParallaxBackground from '../../components/ParallaxBackground.astro';
import Footer from '../../components/Footer.astro';
import TranslationScript from '../../components/TranslationScript.astro';
import Card from '../../components/Card.astro';
import '../../styles/global.css';

const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const navItems = [
  { href: "/", translateKey: "nav.summary", defaultText: "<INICIO/>" },
  { href: "/articles", translateKey: "articles.nav.list", defaultText: "<ARTÍCULOS/>" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <Head
    title="Artículos & Blog Técnico - Luis A. Ruiz Arias"
    description="Artículos y lecciones sobre ingeniería de software, arquitectura cloud y escalabilidad."
  />
  <body
    class="bg-gray-900 text-gray-200 font-sans leading-relaxed selection:bg-purple-500 selection:text-white flex flex-col min-h-screen"
  >
    <ParallaxBackground />
    <Navigation navItems={navItems} />
    <Sidebar navItems={navItems} />

    <main class="relative z-10 pt-20 flex-grow w-full max-w-full overflow-hidden">
      <!-- Hero Section -->
      <section class="min-h-[50vh] flex items-center justify-center pt-24 pb-12 w-full">
        <div class="container mx-auto px-4 max-w-5xl">
          <div class="max-w-3xl animate-fade-in-up">
            <h1 class="text-3xl md:text-5xl lg:text-7xl font-bold text-white mb-6 leading-tight">
              <span class="block text-purple-400 text-xl md:text-2xl font-mono mb-4" data-translate-key="articles.hero.greeting"
                >Blog & Pensamiento Técnico</span
              >
              Artículos & Lecciones de <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-500">Ingeniería de Software</span>
            </h1>
            <p
              class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl font-light"
              data-translate-key="articles.hero.tagline"
            >
              Lecciones sobre arquitectura cloud, escalabilidad y desarrollo.
            </p>
          </div>
        </div>
      </section>

      <!-- Articles Grid -->
      <section class="py-12 md:py-20 w-full relative">
        <div class="container mx-auto px-4 max-w-5xl relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            {articles.map((article) => (
              <Card>
                <div class="p-6 h-full flex flex-col">
                  <div class="text-sm text-purple-400 mb-2 font-mono">
                    {new Intl.DateTimeFormat('es-MX', { dateStyle: 'long' }).format(article.data.pubDate)}
                  </div>
                  <h3 class="text-2xl font-bold text-white mb-3 hover:text-purple-400 transition-colors">
                    <a href={`/articles/${article.id}`}>
                      {article.data.title}
                    </a>
                  </h3>
                  <p class="text-gray-400 mb-6 flex-grow">
                    {article.data.description}
                  </p>

                  <div class="mt-auto">
                    <div class="flex flex-wrap gap-2 mb-4">
                      {article.data.tags.map((tag: string) => (
                        <span class="text-xs font-mono text-purple-300 bg-purple-900/30 px-2 py-1 rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <a
                      href={`/articles/${article.id}`}
                      class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium transition-colors"
                      data-translate-key="articles.read_more"
                    >
                      Leer Artículo <span class="ml-2">→</span>
                    </a>
                  </div>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <TranslationScript />
  </body>
</html>
