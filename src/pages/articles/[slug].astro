---
import { getCollection, render } from 'astro:content';
import Head from '../../components/Head.astro';
import Navigation from '../../components/Navigation.astro';
import Sidebar from '../../components/Sidebar.astro';
import ParallaxBackground from '../../components/ParallaxBackground.astro';
import Footer from '../../components/Footer.astro';
import TranslationScript from '../../components/TranslationScript.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const navItems = [
  { href: "/", translateKey: "nav.summary", defaultText: "<INICIO/>" },
  { href: "/articles", translateKey: "articles.nav.list", defaultText: "<ARTÍCULOS/>" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <Head
    title={`${article.data.title} - Blog Técnico - Luis A. Ruiz Arias`}
    description={article.data.description}
  />
  <body
    class="bg-gray-900 text-gray-200 font-sans leading-relaxed selection:bg-purple-500 selection:text-white flex flex-col min-h-screen"
  >
    <ParallaxBackground />
    <Navigation navItems={navItems} />
    <Sidebar navItems={navItems} />

    <main class="relative z-10 pt-24 pb-16 flex-grow w-full max-w-full overflow-hidden">
      <article class="container mx-auto px-4 max-w-3xl relative z-10 animate-fade-in-up">

        <div class="mb-8">
          <a href="/articles" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium transition-colors mb-6" data-translate-key="articles.back">
            <span class="mr-2">←</span> Volver a Artículos
          </a>

          <div class="text-sm text-purple-400 mb-4 font-mono">
            {new Intl.DateTimeFormat('es-MX', { dateStyle: 'long' }).format(article.data.pubDate)}
          </div>

          <h1 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
            {article.data.title}
          </h1>

          <div class="flex flex-wrap gap-2 mb-8">
            {article.data.tags.map((tag: string) => (
              <span class="text-xs font-mono text-purple-300 bg-purple-900/30 px-2 py-1 rounded">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="prose prose-invert prose-purple max-w-none prose-headings:text-white prose-a:text-purple-400 hover:prose-a:text-purple-300 prose-img:rounded-xl prose-pre:bg-gray-800 prose-pre:border prose-pre:border-gray-700">
          <Content />
        </div>

      </article>
    </main>
    <Footer />
    <TranslationScript />
  </body>
</html>
